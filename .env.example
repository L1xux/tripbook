OPENAI_API_KEY=sk-...
SWEETBOOK_API_KEY=sb-...
SWEETBOOK_ENV=sandbox
# PUT /webhooks/config 등록 시 1회만 전체값이 내려오는 secretKey.
# 비어 있으면 웹훅 서명 검증을 생략한다(로컬 전용) — 공개 배포 전 반드시 채울 것.
SWEETBOOK_WEBHOOK_SECRET=whsk_...
PUBLIC_WEB_BASE=http://localhost:5273
# 배포한 프론트 주소. 쉼표로 여러 개. 비어 있으면 전부 허용(로컬 개발용)
CORS_ORIGINS=https://tripbook.onrender.com
